{# Badge de statut, couleurs et icônes communes à tous les plugins (charte section 8) :
   ok (vert), warning (orange), danger (rouge), info (bleu), neutral (gris), en classes de thème
   -subtle/-emphasis : les bg-X-lt n'atteignent pas le contraste WCAG AA (axe-core).
   Usage : {% include '@monplugin/_badge.html.twig' with {kind: 'ok', label: __('Up to date', 'monplugin')} %} #}
{% set styles = {
   'ok':      ['bg-success-subtle text-success-emphasis', 'ti-circle-check'],
   'warning': ['bg-warning-subtle text-warning-emphasis', 'ti-alert-triangle'],
   'danger':  ['bg-danger-subtle text-danger-emphasis', 'ti-alert-octagon'],
   'info':    ['bg-info-subtle text-info-emphasis', 'ti-loader'],
   'neutral': ['bg-secondary-subtle text-secondary-emphasis', 'ti-circle-dashed'],
} %}
{% set style = styles[kind] ?? styles['neutral'] %}
<span class="badge {{ style[0] }}"><i class="ti {{ style[1] }} me-1"></i>{{ label }}</span>
