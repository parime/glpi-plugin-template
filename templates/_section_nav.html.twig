{# Onglets des écrans regroupés sous la seule entrée de menu du plugin (charte section 9).
   tabs : liste de {label, icon, url, active}, déjà filtrée selon les droits. #}
{% if tabs|length > 1 %}
<ul class="nav nav-tabs mb-3">
   {% for tab in tabs %}
      <li class="nav-item">
         <a class="nav-link{{ tab.active ? ' active' : '' }}" href="{{ tab.url }}"{% if tab.active %} aria-current="page"{% endif %}>
            {% if tab.icon %}<i class="{{ tab.icon }} me-1"></i>{% endif %}{{ tab.label }}
         </a>
      </li>
   {% endfor %}
</ul>
{% endif %}
