msgid "My plugin"
msgstr "Mi plugin"

msgid "Settings saved."
msgstr "Ajustes guardados."

msgid "Overview"
msgstr "Resumen"

msgid "What is this page for?"
msgstr "¿Para qué sirve esta página?"

msgid "What is expected:"
msgstr "Lo que se espera:"

msgid "This page gathers what the plugin follows for you."
msgstr "Esta página reúne lo que el plugin sigue por usted."

msgid "Review the items marked in orange or red first."
msgstr "Revise primero los elementos marcados en naranja o en rojo."

msgid "Up to date"
msgstr "Al día"

msgid "Nothing to show yet"
msgstr "Nada que mostrar todavía"

msgid "Start by setting up the plugin in Setup > Plugins."
msgstr "Empiece configurando el plugin en Configuración > Plugins."

msgid "All the settings of the plugin, and only here."
msgstr "Todos los ajustes del plugin, y solo aquí."

msgid "Fill in each tab, then save."
msgstr "Complete cada pestaña y guarde."

msgid "General"
msgstr "General"

msgid "About"
msgstr "Acerca de"

msgid "Enable the example"
msgstr "Activar el ejemplo"

msgid "Example label"
msgstr "Etiqueta de ejemplo"

msgid "Shown on the overview page."
msgstr "Se muestra en la página de resumen."

msgid "Version"
msgstr "Versión"

msgid "License"
msgstr "Licencia"

msgid "Check for new versions on GitHub"
msgstr "Buscar nuevas versiones en GitHub"

msgid "Reads the latest release published on GitHub at most every 12 hours, without sending any information about this GLPI. Turn it off on a server without Internet access."
msgstr "Lee la última versión publicada en GitHub como máximo cada 12 horas, sin enviar ninguna información sobre este GLPI. Desactívelo en un servidor sin acceso a Internet."

msgid "the check is turned off in the settings below"
msgstr "la verificación está desactivada en los ajustes de abajo"

msgid "GitHub cannot be reached from the GLPI server (no Internet access, proxy or firewall)"
msgstr "No se puede acceder a GitHub desde el servidor GLPI (sin acceso a Internet, proxy o cortafuegos)"

msgid "the GitHub request limit is reached, a new attempt will be made within an hour"
msgstr "se ha alcanzado el límite de solicitudes de GitHub, se hará un nuevo intento dentro de una hora"

msgid "GitHub did not answer within 3 seconds"
msgstr "GitHub no respondió en 3 segundos"

msgid "no release is published on GitHub yet"
msgstr "todavía no hay ninguna versión publicada en GitHub"

msgid "the answer from GitHub could not be read"
msgstr "no se pudo leer la respuesta de GitHub"

msgid "Plugin version"
msgstr "Versión del plugin"

msgid "Installed version"
msgstr "Versión instalada"

msgid "Latest release on GitHub"
msgstr "Última versión en GitHub"

#, php-format
msgid "Update available: %s"
msgstr "Actualización disponible: %s"

msgid "Latest version unknown"
msgstr "Última versión desconocida"

msgid "Release notes"
msgstr "Notas de la versión"

msgid "Download the archive"
msgstr "Descargar el archivo"

#, php-format
msgid "Last check failed: %s."
msgstr "La última verificación falló: %s."

#, php-format
msgid "Result of the last successful check (%s) shown."
msgstr "Se muestra el resultado de la última verificación correcta (%s)."

#, php-format
msgid "Reason: %s."
msgstr "Motivo: %s."

#, php-format
msgid "Last successful check: %s."
msgstr "Última verificación correcta: %s."

msgid "No successful check yet."
msgstr "Todavía no hay ninguna verificación correcta."

msgid "See the releases on GitHub"
msgstr "Ver las versiones en GitHub"

#, php-format
msgid "Last checked: %s (checked again every 12 hours)."
msgstr "Última verificación: %s (se verifica de nuevo cada 12 horas)."
