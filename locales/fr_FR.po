msgid "My plugin"
msgstr "Mon plugin"

msgid "Settings saved."
msgstr "Réglages enregistrés."

msgid "Overview"
msgstr "Vue d'ensemble"

msgid "What is this page for?"
msgstr "À quoi sert cette page ?"

msgid "What is expected:"
msgstr "Ce qui est attendu :"

msgid "This page gathers what the plugin follows for you."
msgstr "Cette page rassemble ce que le plugin suit pour vous."

msgid "Review the items marked in orange or red first."
msgstr "Commencez par les éléments signalés en orange ou en rouge."

msgid "Up to date"
msgstr "À jour"

msgid "Nothing to show yet"
msgstr "Rien à afficher pour l'instant"

msgid "Start by setting up the plugin in Setup > Plugins."
msgstr "Commencez par régler le plugin dans Configuration > Plugins."

msgid "All the settings of the plugin, and only here."
msgstr "Tous les réglages du plugin, et seulement ici."

msgid "Fill in each tab, then save."
msgstr "Renseignez chaque onglet, puis enregistrez."

msgid "General"
msgstr "Général"

msgid "About"
msgstr "À propos"

msgid "Enable the example"
msgstr "Activer l'exemple"

msgid "Example label"
msgstr "Libellé d'exemple"

msgid "Shown on the overview page."
msgstr "Affiché sur la page de vue d'ensemble."

msgid "Version"
msgstr "Version"

msgid "License"
msgstr "Licence"

msgid "Check for new versions on GitHub"
msgstr "Vérifier les nouvelles versions sur GitHub"

msgid "Reads the latest release published on GitHub at most every 12 hours, without sending any information about this GLPI. Turn it off on a server without Internet access."
msgstr "Lit la dernière version publiée sur GitHub au plus toutes les 12 heures, sans envoyer aucune information sur ce GLPI. À désactiver sur un serveur sans accès à Internet."

msgid "the check is turned off in the settings below"
msgstr "la vérification est désactivée dans les réglages ci-dessous"

msgid "GitHub cannot be reached from the GLPI server (no Internet access, proxy or firewall)"
msgstr "GitHub est injoignable depuis le serveur GLPI (pas d'accès à Internet, proxy ou pare-feu)"

msgid "the GitHub request limit is reached, a new attempt will be made within an hour"
msgstr "la limite de requêtes de GitHub est atteinte, un nouvel essai sera fait d'ici une heure"

msgid "GitHub did not answer within 3 seconds"
msgstr "GitHub n'a pas répondu dans les 3 secondes"

msgid "no release is published on GitHub yet"
msgstr "aucune version n'est encore publiée sur GitHub"

msgid "the answer from GitHub could not be read"
msgstr "la réponse de GitHub est illisible"

msgid "Plugin version"
msgstr "Version du plugin"

msgid "Installed version"
msgstr "Version installée"

msgid "Latest release on GitHub"
msgstr "Dernière version sur GitHub"

#, php-format
msgid "Update available: %s"
msgstr "Mise à jour disponible : %s"

msgid "Latest version unknown"
msgstr "Dernière version inconnue"

msgid "Release notes"
msgstr "Notes de version"

msgid "Download the archive"
msgstr "Télécharger l'archive"

#, php-format
msgid "Last check failed: %s."
msgstr "La dernière vérification a échoué : %s."

#, php-format
msgid "Result of the last successful check (%s) shown."
msgstr "Résultat de la dernière vérification réussie (%s) affiché."

#, php-format
msgid "Reason: %s."
msgstr "Raison : %s."

#, php-format
msgid "Last successful check: %s."
msgstr "Dernière vérification réussie : %s."

msgid "No successful check yet."
msgstr "Aucune vérification réussie pour l'instant."

msgid "See the releases on GitHub"
msgstr "Voir les versions sur GitHub"

#, php-format
msgid "Last checked: %s (checked again every 12 hours)."
msgstr "Dernière vérification : %s (nouvelle vérification toutes les 12 heures)."
